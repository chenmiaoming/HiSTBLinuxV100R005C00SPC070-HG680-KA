# HG-680-KA Linux 4.4 board/server configuration fragment
#
# This is merged after hi3798mv310_defconfig. Keep the SoC/vendor defconfig as
# the compatibility baseline and put board-specific cleanup here.

# Kernel identity
CONFIG_LOCALVERSION="-HG680-KA"

# Keep the storage/network pieces required by the current Ubuntu server setup
# explicit even if the vendor baseline changes later.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_MMC=y
CONFIG_HIMCIV300_SDIO_SYNOPSYS=y
CONFIG_HG680KA_SDIO_DETECT=m
# CONFIG_MMC_DW is not set
CONFIG_EXT4_FS=y
CONFIG_FUSE_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_IPV6=y
CONFIG_CFG80211=y
CONFIG_RFKILL=y
CONFIG_HIETH_GMAC=y
CONFIG_HIGMAC_DESC_4WORD=y
CONFIG_HIGMAC_RXCSUM=y

# Ubuntu 22.04 services such as chrony use seccomp syscall filtering. ARM EABI
# selects HAVE_ARCH_SECCOMP_FILTER in this kernel, so enabling SECCOMP also
# enables CONFIG_SECCOMP_FILTER when its normal dependencies are satisfied.
CONFIG_SECCOMP=y

# Debug / tracing / test facilities that are not wanted in the server image.
# CONFIG_IRQ_DOMAIN_DEBUG is not set
# CONFIG_DEBUG_BLK_CGROUP is not set
# CONFIG_IP_ROUTE_VERBOSE is not set
# CONFIG_L2TP_DEBUGFS is not set
# CONFIG_OF_UNITTEST is not set
# CONFIG_DM_DEBUG is not set
# CONFIG_NVM_DEBUG is not set
# CONFIG_POWER_SUPPLY_DEBUG is not set
# CONFIG_USB_STORAGE_DEBUG is not set
# CONFIG_USBIP_DEBUG is not set
# CONFIG_USB_SERIAL_DEBUG is not set
# CONFIG_USB_TEST is not set
# CONFIG_MMC_SIMULATE_MAX_SPEED is not set
# CONFIG_JFS_DEBUG is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_TEST_UDELAY is not set
# CONFIG_DEBUG_USER is not set

# Clearly unrelated protocol/virtual-device support.
# CONFIG_IEEE802154 is not set
# CONFIG_VSOCKETS is not set
# CONFIG_BT_HCIVHCI is not set

# PC/workstation storage devices that do not exist on HG-680-KA.
# CONFIG_BLK_DEV_PCIESSD_MTIP32XX is not set
# CONFIG_BLK_DEV_UMEM is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_TIFM_CORE is not set
# CONFIG_CB710_CORE is not set
# CONFIG_CHR_DEV_ST is not set

# PCI/PC Ethernet adapters; retain the HiSilicon GMAC and PHY stack.
# CONFIG_8139CP is not set
# CONFIG_8139TOO is not set
# CONFIG_R8169 is not set

# Generic Wi-Fi drivers unrelated to the on-board MediaTek MT7668.  Keep
# cfg80211/RFKILL and SDIO infrastructure for the MT7668 port.
# CONFIG_USB_NET_RNDIS_WLAN is not set
# CONFIG_BRCMSMAC is not set
# CONFIG_HOSTAP is not set
# CONFIG_IWL3945 is not set
# CONFIG_HERMES is not set
# CONFIG_RTL8192CU is not set
# CONFIG_WL_TI is not set
# CONFIG_NVM is not set

# Input/media/audio devices not needed by the headless server profile.
# Generic USB HID itself remains available; only the extra joystick/gameport
# and multimedia stacks are removed here.
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_GAMEPORT is not set
# CONFIG_MEDIA_CAMERA_SUPPORT is not set
# CONFIG_MEDIA_USB_SUPPORT is not set
# CONFIG_SOUND is not set

# Exotic USB peripheral/test/storage transports.  Keep the normal USB mass
# storage, UAS, xHCI/EHCI/OHCI and useful USB-serial support from the baseline.
# CONFIG_USB_PRINTER is not set
# CONFIG_USBIP_CORE is not set
# CONFIG_USB_LCD is not set
# CONFIG_USB_LED is not set
# CONFIG_USB_LD is not set
# CONFIG_USB_IOWARRIOR is not set
# CONFIG_USB_STORAGE_REALTEK is not set
# CONFIG_USB_STORAGE_DATAFAB is not set
# CONFIG_USB_STORAGE_FREECOM is not set
# CONFIG_USB_STORAGE_ISD200 is not set
# CONFIG_USB_STORAGE_USBAT is not set
# CONFIG_USB_STORAGE_SDDR09 is not set
# CONFIG_USB_STORAGE_SDDR55 is not set
# CONFIG_USB_STORAGE_JUMPSHOT is not set
# CONFIG_USB_STORAGE_ALAUDA is not set
# CONFIG_USB_STORAGE_ONETOUCH is not set
# CONFIG_USB_STORAGE_KARMA is not set
# CONFIG_USB_STORAGE_CYPRESS_ATACB is not set
# CONFIG_USB_STORAGE_ENE_UB6250 is not set
# CONFIG_USB_DWC2_PCI is not set

# The HG-680-KA uses the vendor HiSilicon himciv300 path for SDIO1.  Generic
# DesignWare MMC and unrelated glue are intentionally disabled for this board.
# CONFIG_MMC_DW_EXYNOS is not set

# Filesystems for media/flash types not used by the eMMC/USB Ubuntu setup.
# Keep ext4, FAT/VFAT, FUSE, overlayfs, tmpfs and network filesystems from the
# baseline.
# CONFIG_REISERFS_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_YAFFS_FS is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_UBIFS_FS is not set
