From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HG680-KA bring-up <noreply@example.com>
Date: Thu, 27 Aug 2026 00:00:00 +0000
Subject: [PATCH] arm64: add HG680-KA secondary boot UART markers

Temporary bring-up instrumentation. Emit compact physical-PL011 markers while
secondary CPUs still run with the MMU disabled:

  A<n>  entered secondary_entry
  B<n>  returned from init_kernel_el
  C<n>  entered secondary_startup
  D<n>  returned from __cpu_setup, immediately before __enable_mmu

<n> is MPIDR Aff0. The code deliberately uses only x9/x10, which are scratch
registers at these entry points, and does not depend on a stack or page tables.
---
 arch/arm64/kernel/head.S | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -37,3 +37,16 @@
 #include "efi-header.S"
 
+/* HG680-KA temporary secondary CPU bring-up marker. */
+	.macro	hg680ka_uart_marker, ch
+	movz	x9, #0xf8b0, lsl #16
+	mov	w10, #\ch
+	str	w10, [x9]
+	mrs	x10, mpidr_el1
+	and	w10, w10, #0xff
+	add	w10, w10, #'0'
+	str	w10, [x9]
+	mov	w10, #' '
+	str	w10, [x9]
+	.endm
+
 #if (PAGE_OFFSET & 0x1fffff) != 0
@@ -1027,5 +1040,7 @@ SYM_FUNC_START(secondary_entry)
+	hg680ka_uart_marker 0x41
 	mov	x0, xzr
 	bl	init_kernel_el			// w0=cpu_boot_mode
+	hg680ka_uart_marker 0x42
 	b	secondary_startup
 SYM_FUNC_END(secondary_entry)
@@ -1038,3 +1053,4 @@ SYM_FUNC_START_LOCAL(secondary_startup)
 	mov	x20, x0				// preserve boot mode
+	hg680ka_uart_marker 0x43
 
 #ifdef CONFIG_ARM64_VA_BITS_52
@@ -1048,4 +1064,5 @@ alternative_else_nop_endif
 	bl	__cpu_setup			// initialise processor
+	hg680ka_uart_marker 0x44
 	adrp	x1, swapper_pg_dir
 	adrp	x2, idmap_pg_dir
 	bl	__enable_mmu
-- 
2.39.2
